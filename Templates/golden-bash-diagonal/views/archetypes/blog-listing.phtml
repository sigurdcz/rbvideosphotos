/** @var array $posts */
$blockMap = [];
foreach (($blocks ?? []) as $block) {
    $blockMap[(string) ($block['block_key'] ?? '')] = (string) ($block['content'] ?? '');
}
/** Database block first, the former hardcoded literal as the fallback. */
$t = static fn(string $key, string $default): string =>
    trim((string) ($blockMap[$key] ?? '')) !== '' ? (string) $blockMap[$key] : $default;
?>
