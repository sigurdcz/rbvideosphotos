<?php
$items = $mixedEntries ?? [];
$blockMap = [];
foreach (($blocks ?? []) as $block) {
    $blockMap[(string) ($block['block_key'] ?? '')] = (string) ($block['content'] ?? '');
}
/** Database block first, the former hardcoded literal as the fallback. */
$t = static fn(string $key, string $default): string =>
    trim((string) ($blockMap[$key] ?? '')) !== '' ? (string) $blockMap[$key] : $default;
$galleryJson = static function (array $photos): string {
    $items = array_map(static fn (array $photo): array => [
        'src' => (string)($photo['url'] ?? ''),
        'thumb' => (string)($photo['url'] ?? ''),
        'alt' => (string)($photo['alt'] ?? ''),
    ], $photos);

    return json_encode(
        $items,
        JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR
    );
};
