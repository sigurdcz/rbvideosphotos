<?php /** @var array $lines @var array $map @var string $cta @var array $form */ ?>
<div class="premium-contact-grid">
  <div class="premium-contact-form-wrap">
    <form class="premium-contact-form" method="POST" action="/kontakt/odeslat">
      <input type="hidden" name="_csrf" value="<?= $this->e($form['csrfToken']) ?>">
      <input type="hidden" name="website" value="" autocomplete="off">
      <div class="field"><label>Vaše jména</label><input type="text" name="name" required placeholder="Tereza a Marek"></div>
      <div class="field"><label>Místo</label><input type="text" name="event_place" placeholder="Olomouc"></div>
      <div class="field"><label>E-mail nebo telefon</label><input type="text" name="contact_value" required placeholder="vas@email.cz"></div>
      <input type="hidden" name="shooting_type" value="svatebni">
      <div class="field"><label>Co plánujete?</label><textarea name="message" required placeholder="Chceme foto i video…"></textarea></div>
      <label class="premium-consent"><input type="checkbox" name="privacy_consent" required> Souhlasím se zpracováním osobních údajů.</label>
      <button class="btn btn-solid" type="submit">Odeslat poptávku</button>
    </form>
  </div>
  <aside class="premium-contact-data">
    <?php foreach ($lines as $line): ?>
      <?php if ($line['kind'] === 'phone'): ?><a href="tel:<?= $this->e($line['tel']) ?>"><?= $this->e($line['phone']) ?></a>
      <?php elseif ($line['kind'] === 'email'): ?><a href="mailto:<?= $this->e($line['email']) ?>"><?= $this->e($line['email']) ?></a>
      <?php elseif ($line['kind'] === 'address'): ?><span><?= nl2br($this->e($line['address'])) ?></span>
      <?php elseif ($line['kind'] === 'social'): ?><a href="<?= $this->e($line['url']) ?>" target="_blank" rel="noopener"><?= ucfirst($this->e($line['type'])) ?></a><?php endif; ?>
    <?php endforeach; ?>
    <?= $this->raw($cta) ?>
  </aside>
</div><?php ?>
