<?php /** @var list<array{title:string,price:string,summary:string,featured:bool}> $cards */ ?>
<div class="hp-cenik-grid"><?php foreach ($cards as $card): ?><article class="hp-cenik-card<?= $card['featured'] ? ' hp-cenik-card--featured' : '' ?>"><?php if ($card['featured']): ?><span class="hp-cenik-card-badge">Nejoblíbenější</span><?php endif; ?><div class="hp-cenik-card-body"><h3 class="hp-cenik-card-title"><?= $this->e($card['title']) ?></h3><?= $card['summary'] !== '' ? '<div class="hp-cenik-card-desc">' . $this->e($card['summary']) . '</div>' : '' ?></div></article><?php endforeach; ?></div><?php ?>
