<?php
/** @var array $post @var list<array> $gallery */
$featuredImage = (string)($post['image_url'] ?? '');
$usesGalleryHero = $featuredImage === '' && $gallery !== [];
$heroImage = $featuredImage !== '' ? $featuredImage : (string)($gallery[0]['full'] ?? '');
$articleGallery = $usesGalleryHero ? array_slice($gallery, 1) : $gallery;
?>
<section class="video-band bp-hero"><?php if ($heroImage !== ''): ?><img class="hero-bg" src="<?= $this->e($heroImage) ?>" alt="<?= $this->e($post['title']) ?>"><?php endif; ?><div class="video-scrim"></div><div class="wrap"><div class="band-cap"><span class="rec">rec</span><span>blog · <?= $this->e($post['date']) ?></span><span><b>RB</b> journal</span></div><header class="page-head page-head--hero"><span class="eyebrow"><?= $this->e($post['date']) ?></span><h1><?= $this->e($post['title']) ?></h1><p class="lead"><?= $this->e($post['excerpt']) ?></p></header></div></section>
<article class="premium-article"><div class="wrap premium-article-body"><?= $this->raw($post['content']) ?></div><?php if ($articleGallery !== []): ?><div class="wrap tiles tiles-3 premium-article-gallery"><?php foreach ($articleGallery as $g): ?><a class="tile" href="<?= $this->e($g['full']) ?>" style="padding:0"><div class="ph premium-media" style="background-image:url('<?= $this->e($g['thumb']) ?>')"><img src="<?= $this->e($g['thumb']) ?>" alt="<?= $this->e($g['alt']) ?>" loading="lazy"></div></a><?php endforeach; ?></div><?php endif; ?><div class="wrap premium-back"><a class="btn btn-ghost" href="/blog">&larr; Zpět na blog</a></div></article><section class="on-dark premium-page-cta premium-contact-cta"><div class="wrap"><p>Pokud máte nějaké dotazy, neváhejte nás kontaktovat.</p><a class="btn btn-solid" href="/kontakt">Kontaktovat nás</a></div></section><?php ?>
