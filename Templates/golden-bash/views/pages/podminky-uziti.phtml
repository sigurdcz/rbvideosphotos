<?php
/**
 * Golden Bash presentation for the DB-owned terms page.
 *
 * The CMS fragment remains the only content source. This view only enriches its
 * legal cards with stable anchors and a server-rendered table of contents.
 *
 * @var string $fragment
 */
$legalFragment = (string) ($fragment ?? '');
$dom = new DOMDocument('1.0', 'UTF-8');
$previousUseInternalErrors = libxml_use_internal_errors(true);
$loaded = $dom->loadHTML(
    '<?xml encoding="UTF-8"><div id="gb-legal-source">' . $legalFragment . '</div>',
    LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD
);
libxml_clear_errors();
libxml_use_internal_errors($previousUseInternalErrors);

if (!$loaded) {
    throw new RuntimeException('Obsah stránky Podmínky užití se nepodařilo načíst.');
}

$xpath = new DOMXPath($dom);
$cards = $xpath->query('//*[@id="gb-legal-source"]//*[contains(concat(" ", normalize-space(@class), " "), " legal-card ")]');
if ($cards === false || $cards->length === 0) {
    throw new RuntimeException('Stránka Podmínky užití vyžaduje alespoň jeden právní blok.');
}

$tocItems = [];
foreach ($cards as $index => $card) {
    if (!$card instanceof DOMElement) {
        continue;
    }
    $heading = $xpath->query('.//h2|.//h3', $card)?->item(0);
    $label = trim((string) ($heading?->textContent ?? ''));
    if ($label === '') {
        $label = 'Část ' . ($index + 1);
    }
    $id = 'podminky-cast-' . ($index + 1);
    $card->setAttribute('id', $id);
    $card->setAttribute('data-legal-number', str_pad((string) ($index + 1), 2, '0', STR_PAD_LEFT));
    $tocItems[] = ['id' => $id, 'label' => $label];
}

$source = $dom->getElementById('gb-legal-source');
$renderedFragment = '';
if ($source instanceof DOMElement) {
    foreach ($source->childNodes as $child) {
        $renderedFragment .= (string) $dom->saveHTML($child);
    }
}
?>
<div class="gb-legal-page">
  <?= $this->raw($renderedFragment) ?>
  <nav class="gb-legal-toc" aria-label="Obsah podmínek">
    <strong>Rychlá orientace</strong>
    <ol>
      <?php foreach ($tocItems as $item): ?>
        <li><a href="#<?= $this->e($item['id']) ?>"><?= $this->e($item['label']) ?></a></li>
      <?php endforeach; ?>
    </ol>
  </nav>
</div>
