$blockMap = [];
foreach (($blocks ?? []) as $block) {
    $blockMap[(string) ($block['block_key'] ?? '')] = (string) ($block['content'] ?? '');
}
/**
 * Editable copy: the database block wins, the literal below is the fallback that
 * keeps the page intact before the migration runs (and on a site that never gets
 * one). Every key passed here is also wired to inlineAttr(), so the same text is
 * editable both in the admin "Bloky obsahu" tab and inline on the page.
 */
$t = static fn(string $key, string $default): string =>
    trim((string) ($blockMap[$key] ?? '')) !== '' ? (string) $blockMap[$key] : $default;
$photographerImage = trim($blockMap['about_photographer_image'] ?? '');
$cameramanImage = trim($blockMap['about_cameraman_image'] ?? '');
$photographerVideoUrl = trim($blockMap['about_photographer_video'] ?? '');
$cameramanVideoUrl = trim($blockMap['about_cameraman_video'] ?? '');
