$cameramanVideoEmbed = $cameramanVideoUrl !== '' ? \App\Services\Render\HeroMediaRenderer::buildVideoEmbedUrl($cameramanVideoUrl) : '';
$heroHeading = trim($blockMap['hero_h1'] ?? $blockMap['hero_heading'] ?? '');
if ($heroHeading === '') {
    throw new RuntimeException('Stránka O nás vyžaduje databázový H1 nadpis.');
}
$reviews = array_values(array_filter(
    is_array($reviews ?? null) ? $reviews : [],
    static fn(array $review): bool => trim((string)($review['review_text'] ?? '')) !== ''
));
$stories = array_values(array_filter(
    is_array($stories ?? null) ? $stories : [],
    static fn(array $story): bool => trim((string)($story['slug'] ?? '')) !== ''
        && trim((string)($story['title'] ?? '')) !== ''
));
if ($photographerImage === '' || $cameramanImage === '') {
    throw new RuntimeException('Stránka O nás vyžaduje oba mediální bloky týmu.');
}
$sourceFragment = preg_replace(
    '~<h1\b([^>]*)>.*?</h1>~is',
    '<h2$1>Dva lidé, jeden společný příběh</h2>',
    (string) $fragment,
    1
) ?? (string) $fragment;
