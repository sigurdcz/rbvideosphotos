Options -Indexes
AddDefaultCharset UTF-8
RewriteEngine On
RewriteBase /

# Admin assets — serve directly
RewriteRule ^admin/assets/(.*)$ admin/assets/$1 [L]

# Admin panel
RewriteRule ^admin(/.*)?$ admin/index.php [L,QSA]

# Storage media — serve directly
RewriteRule ^storage/media/(.*)$ storage/media/$1 [L]

# Everything else (non-file) → public front controller
# NOTE: directories are intentionally included so that / and sub-paths
# reach public/index.php (which serves storage/published/ or edit mode).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/index\.php
RewriteRule ^(.*)$ public/index.php [L,QSA]
