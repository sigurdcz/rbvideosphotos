<?php /** @var string $siteName; @var string $nav; @var string $content
 * Core default PHTML layout - the fallback shell for a theme that opts into the
 * PHTML view pipeline but ships no Templates/<key>/views/layout.phtml of its own.
 * In phase 3 no active theme uses this directly (elegant-white3 has its own
 * layout.phtml); it documents the intended slot structure and is unit-tested.
