<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><?= $this->e($siteName) ?></title>
</head>
<body>
  <div class="theme-shell">
    <header class="theme-header">
      <div class="container theme-header__inner">
        <a href="/" class="theme-brand"><?= $this->partial('partials/logo', ['siteName' => $siteName]) ?></a>
        <div class="theme-nav-wrap"><?= $this->partial('partials/nav', ['nav' => $nav, 'siteName' => $siteName]) ?></div>
      </div>
    </header>
    <main class="theme-main">
      <?= $this->raw($content) ?>

    </main>
    <footer class="theme-footer"></footer>
