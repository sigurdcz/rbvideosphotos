<?php
/**
 * FAQ archetype - phase 4 of the templating refactor.
 * @var array $hero  ['title','sub','titleKey','titleType','subKey','subType']
 * @var array $items [['id','question','answer'], ...] from FaqPageData::forSite()
 */
?>
<section class="fq-hero">
  <div class="container">
    <h1<?= $this->inlineAttr($hero['titleKey'], $hero['titleType']) ?>><?= $this->e($hero['title']) ?></h1>
    <p<?= $this->inlineAttr($hero['subKey'], $hero['subType']) ?>><?= $this->e($hero['sub']) ?></p>
  </div>
</section>
<section class="fq-wrap">
  <div class="container">
    <div class="faq-list"><?php if ($items === []): ?><p class="faq-empty">Zatím žádné otázky. Napište nám a rádi odpovíme.</p><?php else: foreach ($items as $item): ?><details class="faq-item"<?= $this->isEditMode() ? ' open' : '' ?>><summary class="faq-q-wrap"><h3 class="faq-q"><span<?= $this->inlineAttr('faq:' . $item['id'] . ':question') ?>><?= $this->e($item['question']) ?></span></h3></summary><div class="faq-a"<?= $this->inlineAttr('faq:' . $item['id'] . ':answer') ?>><?= nl2br($this->e($item['answer'])) ?></div></details><?php endforeach; endif; ?></div>
  </div>
</section>
<?php if ($items !== []): ?>
<script type="application/ld+json"><?= json_encode([
    '@context' => 'https://schema.org',
    '@type' => 'FAQPage',
    'mainEntity' => array_map(static fn (array $item): array => [
        '@type' => 'Question',
        'name' => $item['question'],
        'acceptedAnswer' => ['@type' => 'Answer', 'text' => $item['answer']],
    ], $items),
], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?></script>
<?php endif; ?><?php ?>
