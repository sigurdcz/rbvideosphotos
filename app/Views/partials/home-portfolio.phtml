<?php /** @var list<array{href:string,title:string,thumbUrl:string,hasVideo:bool,photos:list<array{url:string,alt:string}>}> $tiles — see App\ViewModels\HomepageData::portfolioTile() */ ?>
<div class="pt-grid"><?php foreach ($tiles as $tile): ?><a class="pt-tile" href="<?= $this->e($tile['href']) ?>">
  <div class="pt-caption"><?= $this->e($tile['title']) ?></div>
  <div class="pt-thumb"><?= $tile['thumbUrl'] !== '' ? '<img src="' . $this->e($tile['thumbUrl']) . '" alt="' . $this->e($tile['title']) . '" loading="lazy">' : '<div class="pt-thumb-placeholder">&#9654;</div>' ?><?= $tile['hasVideo'] ? '<span class="pt-play">&#9654;</span>' : '' ?></div>
  <div class="pt-photos"><?php foreach ($tile['photos'] as $photo): ?><img src="<?= $this->e($photo['url']) ?>" alt="<?= $this->e($photo['alt']) ?>" loading="lazy"><?php endforeach; ?></div>
</a><?php endforeach; ?></div><?php ?>
