<?php /** @var array $lines @var array $map @var string $cta @var array $form — see App\ViewModels\HomepageData::contact() */ ?>
<div class="hp-contact-grid"><div class="hp-contact-box"><div class="hp-contact-lines"><?php if ($lines === []): ?><p class="hp-contact-empty">Doplňte kontaktní informace v administraci.</p><?php else: foreach ($lines as $line): ?><div class="hp-contact-row"><span class="hp-contact-label"><?= ['phone' => 'Telefon', 'email' => 'E-mail', 'address' => 'Adresa', 'social' => 'Sítě'][$line['kind']] ?></span><?php if ($line['kind'] === 'phone'): ?><a href="tel:<?= $this->e($line['tel']) ?>"><?= $this->e($line['phone']) ?></a><?php elseif ($line['kind'] === 'email'): ?><a href="mailto:<?= $this->e($line['email']) ?>"><?= $this->e($line['email']) ?></a><?php elseif ($line['kind'] === 'address'): ?><span><?= nl2br($this->e($line['address'])) ?></span><?php elseif ($line['kind'] === 'social'): ?><a href="<?= $this->e($line['url']) ?>" target="_blank" rel="noopener"><?= ucfirst($this->e($line['type'])) ?></a><?php endif; ?></div><?php endforeach; endif; ?></div><?php if ($map['kind'] === 'iframe'): ?><iframe class="hp-contact-map-embed" src="<?= $this->e($map['url']) ?>" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><?php elseif ($map['kind'] === 'link'): ?><a href="<?= $this->e($map['url']) ?>" target="_blank" rel="noopener" class="hp-contact-map">Otevřít mapu</a><?php endif; ?><div class="hp-contact-cta"><?= $this->raw($cta) ?></div></div><div class="hp-contact-box"><?php if ($form['showMissingEmailNote']): ?><p class="hp-contact-empty">Formulář je připravený, ale chybí cílový e-mail pro odeslání.</p><?php endif; ?><form class="hp-contact-form" method="POST" action="/kontakt/odeslat"><input type="hidden" name="_csrf" value="<?= $this->e($form['csrfToken']) ?>"><input type="hidden" name="website" value="" autocomplete="off"><label>Jméno a příjmení</label><input type="text" name="name" required placeholder="Vaše jméno"><label>E-mail</label><input type="text" name="contact_value" required placeholder="email nebo telefon"><label>Datum svatby</label><input type="text" name="event_date" placeholder="DD. MM. RRRR"><label>Typ služby</label><select name="shooting_type" required><option value="">Vyberte typ služby</option><option value="svatebni">Svatební foto a video</option><option value="rodinne">Rodinné focení</option><option value="reklamni">Reklamní foto a video</option><option value="jine">Jiné</option></select><label class="hp-contact-form__full">Zpráva</label><textarea class="hp-contact-form__full" name="message" required placeholder="Napište nám..."></textarea><label class="hp-contact-form__full hp-contact-form__consent"><input type="checkbox" name="privacy_consent" required> Souhlasím se zpracováním osobních údajů.</label><button class="hp-contact-form__full" type="submit">Odeslat zprávu</button></form></div></div><?php ?>
