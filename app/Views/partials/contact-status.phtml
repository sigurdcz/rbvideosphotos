<?php
$state = (string) ($form['sentState'] ?? '');
$notices = [
 '1' => ['tone' => 'success', 'icon' => 'check_circle', 'text' => 'Zpráva je bezpečně uložena. E-mail byl předán poštovní službě; doručení do schránky zatím není potvrzené.'],
 'saved' => ['tone' => 'warning', 'icon' => 'warning', 'text' => 'Zpráva je bezpečně uložena. Předání e-mailu se nepodařilo potvrdit, správce ji najde v administraci.'],
 'error' => ['tone' => 'error', 'icon' => 'error', 'text' => 'Zprávu se nepodařilo uložit. Nebyla odeslána. Zkuste to prosím znovu nebo nás kontaktujte přímo.'],
 'invalid' => ['tone' => 'warning', 'icon' => 'warning', 'text' => 'Vyplňte prosím všechna povinná pole a souhlas se zpracováním údajů.'],
 'invalid-package' => ['tone' => 'warning', 'icon' => 'warning', 'text' => 'Vybraný balíček není platný. Vyberte jej prosím znovu.'],
 'csrf' => ['tone' => 'warning', 'icon' => 'warning', 'text' => 'Platnost formuláře vypršela. Obnovte stránku a odešlete zprávu znovu.'],
 'rate-limit' => ['tone' => 'warning', 'icon' => 'warning', 'text' => 'Příliš mnoho pokusů. Zkuste to prosím za pár minut.'],
];
if (isset($notices[$state])) {
    $notice = $notices[$state];
    echo '<div class="kt-success kt-success--' . $notice['tone'] . '" role="status"><span class="kt-status-icon material-symbols-outlined" aria-hidden="true">';
    echo $notice['icon'] . '</span>';
    echo '<span>' . $this->e($notice['text']) . '</span></div>';
}
