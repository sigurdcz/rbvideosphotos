<?php /** @var list<array{id:string,title:string,category:string,badge:string,features:list<string>,featured:bool}> $cards - see App\ViewModels\HomepageData::pricingCards() */ ?>
<div class="hp-cenik-grid"><?php foreach ($cards as $card): ?><div class="hp-cenik-card<?= $card['featured'] ? ' hp-cenik-card--featured' : '' ?>" data-package-id="<?= $this->e($card['id']) ?>"><?php if ($card['featured']): ?><span class="hp-cenik-card-badge"><?= $this->e($card['badge']) ?></span><?php endif; ?><div class="hp-cenik-card-body"><h3 class="hp-cenik-card-title"><?= $this->e($card['title']) ?></h3><?php if ($card['category'] !== ''): ?><span class="gb-price-type"><?= $this->e($card['category']) ?></span><?php endif; ?><?php if ($card['features'] !== []): ?><ul class="hp-cenik-card-features"><?php foreach ($card['features'] as $feature): ?><li><?= $this->e($feature) ?></li><?php endforeach; ?></ul><?php endif; ?></div></div><?php endforeach; ?></div><?php ?>
