<?php /** @var string $nav  pre-built navigation HTML (site layout_nav_home / layout_nav_sub); trusted markup.
 * @var string $siteName  the stored nav template embeds a {site_name} placeholder that the legacy
 * applyLayout() filled by a global str_replace with the escaped site name; reproduce that here so the
