<?php /** @var list<array{stars:string,review_text:string,author_name:string,context_label:string}> $items - see App\ViewModels\HomepageData::reviewCards() */ ?>
<?php if ($items === []): ?><p style="color:rgba(255,255,255,.45);text-align:center;padding:32px 0">Zatím žádné recenze.</p><?php else: ?><div class="hp-reviews-grid"><?php foreach ($items as $item): ?><article class="hp-review-card"><div class="hp-review-stars"><?= $this->e($item['stars']) ?></div><p><?= nl2br($this->e($item['review_text'])) ?></p><strong><?= $this->e($item['author_name']) ?></strong><?= $item['context_label'] !== '' ? '<span>' . $this->e($item['context_label']) . '</span>' : '' ?></article><?php endforeach; ?></div><?php endif; ?><?php ?>
