# Zkopíruj tento soubor jako .env a vyplň hodnoty
# .env NIKDY necommituj do gitu

APP_URL=https://rbvideosphotos.kvalitne.cz
APP_DEBUG=false

# Náhodný token pro migrate-util.php — vygeneruj: php -r "echo bin2hex(random_bytes(20));"
MIGRATE_TOKEN=

# API klíč pro /api/v1/* endpointy — vygeneruj: php -r "echo bin2hex(random_bytes(32));"
API_KEY=

DB_DRIVER=mysql
DB_HOST=mysql.webzdarma.cz
DB_PORT=3306
DB_NAME=nazev_databaze
DB_USER=uzivatel_databaze
DB_PASS=heslo_databaze
