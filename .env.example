# Zkopíruj tento soubor jako .env a vyplň hodnoty
# .env NIKDY necommituj do gitu

APP_URL=https://rbvideosphotos.kvalitne.cz
APP_DEBUG=false

# Náhodný token pro migrate-util.php — vygeneruj: php -r "echo bin2hex(random_bytes(20));"
MIGRATE_TOKEN=

# API klíč pro /api/v1/* endpointy — vygeneruj: php -r "echo bin2hex(random_bytes(32));"
API_KEY=

# ── Databáze ──────────────────────────────────────────────────────────────────
DB_DRIVER=mysql
DB_HOST=mysql.webzdarma.cz
DB_PORT=3306
DB_NAME=nazev_databaze
DB_USER=uzivatel_databaze
DB_PASS=heslo_databaze

# ── Analytics & Tracking ──────────────────────────────────────────────────────
# Google Analytics 4 — Správce → Datové toky → ID měření (G-XXXXXXXXXX)
GA4_ID=G-BD4BS9R4JZ

# Google Tag Manager — containers.google.com → ID kontejneru (GTM-XXXXXXX)
GTM_ID=GTM-542MMSL

# Google Tag Manager admin API
# OAuth client from Google Cloud Console
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=

# Optional override for OAuth callback URL
# If empty, the app uses {APP_URL}/admin/gtm/oauth/callback
GTM_REDIRECT_URI=

# 32-byte encryption key for stored refresh tokens
# Generate: php -r "echo bin2hex(random_bytes(32));"
GTM_ENCRYPTION_KEY=

# Optional overrides for Google endpoints
GTM_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GTM_TOKEN_URI=https://oauth2.googleapis.com/token
GTM_API_BASE_URI=https://tagmanager.googleapis.com/tagmanager/v2

# Optional request tuning
GTM_REQUEST_TIMEOUT=20
GTM_CONNECT_TIMEOUT=10
GTM_RETRY_DELAY_MS=500
# Minimalni rozestup mezi GTM API requesty (rate limiting kvuli nizke kvote)
GTM_MIN_REQUEST_INTERVAL_MS=300

# Microsoft Clarity — clarity.microsoft.com → Nastavení projektu → ID projektu
CLARITY_ID=wss3v71dbz

# Meta Pixel — Meta Events Manager → Datové zdroje → ID pixelu (15-16 číslic)
META_PIXEL_ID=

# ── FTP nasazení ──────────────────────────────────────────────────────────────
FTP_HOST=ftp6.webzdarma.cz
FTP_USER=
FTP_PASS=
