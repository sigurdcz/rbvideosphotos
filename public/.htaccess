Options -Indexes
RewriteEngine On
DirectoryIndex index.php index.html

# Admin panel
RewriteRule ^admin(/.*)?$ /admin/index.php [L,QSA]

# Serve admin assets directly
RewriteRule ^admin/assets/(.*)$ /admin/assets/$1 [L]

# Media files stay private in storage and must be streamed through the front controller.
RewriteRule ^media/.*$ /public/index.php [L,QSA]

# Public front
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ /public/index.php [L,QSA]
