Options -Indexes
RewriteEngine On

# ==========================================================
# SEO REDIRECT: HTTP/WWW -> HTTPS NON-WWW
# Lokalni vyvoj na localhostu zustava na HTTP.
# ==========================================================
RewriteCond %{HTTP_HOST} ^www\.([a-z0-9.-]+)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%1%2%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
# ==========================================================
# KONEC SEO REDIRECTU
# ==========================================================

DirectoryIndex index.php index.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

RewriteRule ^assets/generated/ - [E=CMS_HASHED_ASSET:1]

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # These FilesMatch rules only reach files Apache serves directly. Anything under
  # /assets/ is rewritten to index.php, which sets its own Cache-Control - so the woff2
  # part of this rule never applies to the brand fonts; index.php serves those immutable.
  <FilesMatch "\.(?:png|jpe?g|webp|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header set Cache-Control "public, max-age=31536000, immutable" env=CMS_HASHED_ASSET
</IfModule>

# Admin panel
RewriteRule ^admin(/.*)?$ /admin/index.php [L,QSA]

# Serve admin assets directly
RewriteRule ^admin/assets/(.*)$ /admin/assets/$1 [L]

# Media files stay private in storage and must be streamed through the front controller.
RewriteRule ^media/.*$ /public/index.php [L,QSA]

# Public front
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ /public/index.php [L,QSA]
